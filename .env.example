# Local. No suba este archivo con valores reales: en Railway se cargan en Variables.
EXELLENTI_SECRET=cambiar-esta-clave-en-cualquier-despliegue
EXELLENTI_HOST=127.0.0.1
EXELLENTI_PORT=3939
# EXELLENTI_DATABASE_URL=sqlite:///data/exellenti.db
# EXELLENTI_SKIP_ML=0
# EXELLENTI_HTTPS=0
#
# Railway inyecta PORT y, al agregar PostgreSQL, DATABASE_URL.
# Al arrancar se crean todas las tablas (usuarios, matrícula, notas,
# asistencia, predicciones, citas, seguimientos y bitácora) y, si la base
# está vacía, los datos de tesis. No hace falta importar un .sql.
# Allí defina solo:
#   EXELLENTI_SECRET = una clave larga, distinta de esta
# No defina EXELLENTI_HOST=127.0.0.1 en Railway: el servicio no sería público.
#
# Vercel (mismo repositorio, index.py):
#   EXELLENTI_SECRET = la misma clave larga
#   EXELLENTI_SKIP_ML = 0
# Sin DATABASE_URL, Vercel usa SQLite en /tmp y los datos se pierden al reiniciar.
# La base que permanece es PostgreSQL de Railway.
