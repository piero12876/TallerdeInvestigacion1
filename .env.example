# Local. No suba este archivo con valores reales: en Railway se cargan en Variables.
EXELLENTI_SECRET=cambiar-esta-clave-en-cualquier-despliegue
EXELLENTI_HOST=127.0.0.1
EXELLENTI_PORT=3939
# EXELLENTI_DATABASE_URL=sqlite:///data/exellenti.db
# EXELLENTI_SKIP_ML=0
# EXELLENTI_HTTPS=0
#
# Railway inyecta PORT y, al agregar PostgreSQL, DATABASE_URL.
# Allí defina solo:
#   EXELLENTI_SECRET = una clave larga, distinta de esta
# No defina EXELLENTI_HOST=127.0.0.1 en Railway: el servicio no sería público.
